# ============================================================
# Memory Chain — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# --- Base L2 RPC Endpoints (used by Moccasin deploy script) ---
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# --- BaseScan API Key (optional, for contract verification) ---
BASESCAN_API_KEY=

# --- Optional Deploy Overrides (script/deploy.py) ---
SAFE_MULTISIG_ADDRESS=0x7D29Ae44D5041b59012e784818446088774305F5
MODERATION_MODULE_ADDRESS=

# --- Frontend Network Switch (frontend/.env) ---
# Set VITE_NETWORK=mainnet (Chain ID 8453) or VITE_NETWORK=testnet (Chain ID 84532)
VITE_NETWORK=testnet
VITE_CONTRACT_ADDRESS=0x5de836cf6fc88d88eec93309663372ad723baf8f
VITE_MODERATION_MODULE_ADDRESS=0x7120f05831bab3742b58a0a17e7a9b64789f30f3

# --- Deployer Private Key (NEVER share, NEVER commit) ---
# Only needed for contract deployment scripts (or use `mox wallet import deployer_account`)
DEPLOYER_PRIVATE_KEY=

# --- Arweave ---
# Photos (<= 95 KB) and JSON metadata (~1 KB) are uploaded permanently for free via
# ArDrive Turbo ANS-104 bundler (https://upload.ardrive.io/v1/tx) with an ephemeral key.
ARWEAVE_WALLET_PATH=./arweave-wallet.json
